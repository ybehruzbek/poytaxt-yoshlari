# PostgreSQL (lokal: docker compose up -d)
DATABASE_URL=postgres://ittifoq:ittifoq_dev@127.0.0.1:5437/ittifoq
# Uzun tasodifiy satr: openssl rand -hex 32
PAYLOAD_SECRET=CHANGE_ME
# Saytning to'liq manzili (serverda: https://domen.uz)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Saytdan oldin turgan teskari proksilar soni (Dokploy/Traefik: 1). Murojaat shaklidagi spam cheklovi
# mijoz IP'sini X-Forwarded-For'ning o'ngidan shu raqamdagi qiymatdan oladi.
TRUSTED_PROXY_HOPS=1

# www.uz TOP-reyting (TAS-IX) hisoblagiçi: saytning www.uz dagi raqami (böş bölsa körsatilmaydi)
NEXT_PUBLIC_WWWUZ_ID=

# Telegram kanal bilan avtomatik ulaniş (daqiqa; 0 — öçiq). Production'da sukut: 15
TG_SYNC_MINUTES=15

# Elektron poçta (murojaatlar haqida xabarnoma; aʼzolik arizalari alohida platformaga tuşadi)
# NOTIFY_EMAIL — xabar oladigan manzil(lar), vergul bilan; böş bölsa xabar yuborilmaydi
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Telegram bot (kanal suratlarining asl nusxasi uçun; src/lib/tg/bot.ts ga qarang)
TG_BOT_TOKEN=
TG_BOT_STASH_CHAT=
